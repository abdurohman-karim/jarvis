*.exe
# *.dll
*.so
*.dylib
!/lib/macos/libvosk.dylib

# Static libraries
*.a
# *.lib

# Rust compilation artifacts
*.rlib
*.rmeta

# Backup files and editor temp files
*.rs.bk

# Ignore packaged crates
*.crate

# Ignore AI models
/resources/models/*

# vendored native libraries (pvrecorder)
!/vendor/pvrecorder/data/lib/**

