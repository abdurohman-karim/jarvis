{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": [
      "app",
      "dmg"
    ],
    "externalBin": [
      "binaries/jarvis-app"
    ],
    "resources": {
      "../../lib/macos/libvosk.dylib": "lib/libvosk.dylib",
      "../../vendor/pvrecorder/data/lib/mac/arm64/libpv_recorder.dylib": "lib/libpv_recorder.dylib"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    }
  }
}
